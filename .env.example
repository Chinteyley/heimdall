# Tavily: https://app.tavily.com (hackathon coupon GEEKROOM2)
TAVILY_API_KEY=
# Any provider Bifrost supports; the sample config uses OpenAI.
OPENAI_API_KEY=
# Bifrost virtual keys: one for your apps, one for Heimdall's own checks.
# Any sk-bf- value works; generate with: echo sk-bf-$(openssl rand -hex 16)
BIFROST_VK_APP=sk-bf-change-me-app
BIFROST_VK_CHECKS=sk-bf-change-me-checks
